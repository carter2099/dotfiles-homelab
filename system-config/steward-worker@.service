[Unit]
Description=Homelab Steward bounded P7b repair worker (%i)
Documentation=man:systemd.service
Requires=steward-worker-proxy.service
After=steward-worker-proxy.service

[Service]
Type=oneshot
User=steward-worker
Group=steward-worker
WorkingDirectory=/var/lib/steward-worker/runs/%i
ExecStart=/usr/bin/python3 /usr/local/libexec/steward-worker/worker.py --worker --request /var/lib/steward-worker/requests/%i.json --result /var/lib/steward-worker/runs/%i/result.json
Environment=HOME=/var/lib/steward-worker/runs/%i/home
Environment=XDG_CONFIG_HOME=/etc/steward-worker
Environment=PATH=/usr/local/libexec/steward-worker/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C
Environment=LC_ALL=C
UMask=0077

# The worker never receives Carter's home, OMP auth, SSH, Cloudflare/R2
# credentials, Docker/LXD sockets, or host D-Bus.  Only its own staged source,
# result/session directories and the one fixed proxy socket are visible.
NoNewPrivileges=yes
PrivateUsers=yes
PrivateNetwork=yes
TemporaryFileSystem=/tmp:rw,size=256M,nosuid,nodev /var/tmp:rw,size=256M,nosuid,nodev
PrivateDevices=yes
ProtectHome=tmpfs
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX AF_INET
InaccessiblePaths=-/var/lib/docker -/var/lib/lxd
ReadOnlyPaths=/usr/local/libexec/steward-worker /etc/steward-worker
TemporaryFileSystem=/run:ro /var/lib/steward-worker:ro
BindReadOnlyPaths=/var/lib/steward-worker/requests/%i.json
BindReadOnlyPaths=/run/steward-worker/proxy.sock
BindPaths=/var/lib/steward-worker/runs/%i

# Bounded CPU, memory, process, and wall-clock use for model/tool loops.
CPUQuota=200%
MemoryHigh=1536M
MemoryMax=2G
TasksMax=256
TimeoutStartSec=2700

[Install]
WantedBy=multi-user.target
